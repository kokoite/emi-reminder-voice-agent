# Copy to .env and fill in. Never commit .env.

# Speech-to-text (Sarvam realtime)
SARVAM_API_KEY=

# Gemini: the agent's LLM, and the eval borrower and judge (models are set in config.py)
GOOGLE_API_KEY=

# Text-to-speech (ElevenLabs Flash v2.5)
ELEVENLABS_API_KEY=

# Interruption decision (TypeSafe Jev)
TYPESAFE_API_KEY=
# Optional: a gateway URL if you reach Jev through one. Leave empty for TypeSafe's own API.
TYPESAFE_BASE_URL=

